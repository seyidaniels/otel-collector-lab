{
  "uid": "otel-collector-health",
  "title": "Collector health",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "otel-lab"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Receiver: accepted spans/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role, instance) (rate(otelcol_receiver_accepted_spans[1m]))",
          "legendFormat": "{{role}} {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Receiver: refused spans/s (memory_limiter / backpressure)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role, instance) (rate(otelcol_receiver_refused_spans[1m]))",
          "legendFormat": "{{role}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Exporter: sent spans/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role, exporter) (rate(otelcol_exporter_sent_spans[1m]))",
          "legendFormat": "{{role}} {{exporter}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Exporter: send-failed spans/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role, exporter) (rate(otelcol_exporter_send_failed_spans[1m]))",
          "legendFormat": "{{role}} {{exporter}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exporter queue utilisation",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * otelcol_exporter_queue_size / otelcol_exporter_queue_capacity",
          "legendFormat": "{{role}} {{exporter}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Exporter queue size (batches)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size",
          "legendFormat": "{{role}} {{exporter}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Processor: spans dropped by filter/sampling",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role) (rate({\"otelcol_processor_filter_spans.filtered\"}[1m]))",
          "legendFormat": "filter {{role}}"
        },
        {
          "refId": "B",
          "expr": "sum by (role) (rate(otelcol_processor_tail_sampling_count_traces_sampled[1m]))",
          "legendFormat": "tail_sampling {{role}} {{sampled}}"
        },
        {
          "refId": "C",
          "expr": "sum by (role) (rate(otelcol_processor_tail_sampling_sampling_trace_dropped_too_early[1m]))",
          "legendFormat": "dropped too early {{role}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Process RSS memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_process_memory_rss",
          "legendFormat": "{{role}} {{instance}}"
        }
      ]
    }
  ]
}